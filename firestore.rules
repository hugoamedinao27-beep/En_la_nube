rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección "productos" = catálogo público de la tienda.
    // Justificación:
    //  - READER público (allow read): la tienda es de acceso abierto; el listado,
    //    detalle e imágenes deben verse sin login (github pages).
    //  - WRITER restringido (allow create/update/delete si request.auth != null
    //    y el proveedor es email/contraseña): solo cuentas de administrador
    //    creadas en Firebase Auth pueden registrar, editar o eliminar cartas.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null
        && request.auth.token.sign_in_provider == 'password';
    }
  }
}