rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo los usuarios listados en la colección "admins" pueden gestionar
    // productos y pedidos.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Colección "admins": un documento por UID de administrador.
    // Se puede leer un documento propio (para saber si soy admin), pero nada
    // se escribe desde el navegador. El alta se hace con
    // scripts/agregar_admin.js o a mano desde la consola de Firebase.
    match /admins/{adminId} {
      allow get: if request.auth != null;
      allow write: if false;
    }

    // Colección "productos" = catálogo público de la tienda.
    // Cualquiera puede leer; solo los admin escriben. Los clientes autenticados
    // solo pueden descontar el campo "stock" (al pagar un pedido), nunca
    // aumentarlo ni tocar el resto de los campos.
    match /productos/{productoId} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    // Colección "pedidos": cualquier cliente registrado puede pedir cartas.
    // El cliente ve solo sus pedidos; los admin ven todos y los actualizan.
    match /pedidos/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioEmail == request.auth.token.email;
      allow read: if request.auth != null
        && (resource.data.usuarioId == request.auth.uid || esAdmin());
      allow update, delete: if esAdmin();
    }
  }
}